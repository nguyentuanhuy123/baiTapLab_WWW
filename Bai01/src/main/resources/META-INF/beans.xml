<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="class1" class="iuh.fit.se.bai01.xmlbased.Class_">
        <property name="classId" value="DHKTPM17C"/>
        <property name="className" value="Dai Hoc KTPM17C"/>
    </bean>
    <bean id="student1" class="iuh.fit.se.bai01.xmlbased.Student">
        <property name="id" value="001"/>
        <property name="name" value="Nguyen Van A"/>
    </bean>
    <bean id="student2" class="iuh.fit.se.bai01.xmlbased.Student">
        <property name="id" value="002"/>
        <property name="name" value="Nguyen Van B"/>
        <property name="class_" ref="class1"/>
    </bean>
    <bean id="student3" class="iuh.fit.se.bai01.xmlbased.Student">
        <constructor-arg name="id" value="003"/>
        <constructor-arg name="name" value="Nguyen Van Anh"/>
        <constructor-arg name="class_" ref="class1"/>
    </bean>
    <bean id="address1" class="iuh.fit.se.bai01.xmlbased.Address">
        <constructor-arg name="street" value="Nguyen Van Bao"/>
        <constructor-arg name="city" value="HCM"/>
        <constructor-arg name="country" value="Viet Nam"/>
    </bean>
    <bean id="address2" class="iuh.fit.se.bai01.xmlbased.Address">
        <constructor-arg name="street" value="Nguyen Thai Son"/>
        <constructor-arg name="city" value="HCM"/>
        <constructor-arg name="country" value="Viet Nam"/>
    </bean>
    <bean id="person" class="iuh.fit.se.bai01.xmlbased.Person">
        <property name="name" value="Nguyen Van Al"/>
        <property name="addresses" >
            <list>
                <ref bean="address1"/>
                <ref bean="address2"/>
            </list>
        </property>
        <property name="emails" >
            <list>
                <value>a1@gmail.com</value>
                <value>a1@yogmail.com</value>
            </list>
        </property>
        <property name="age" value="30"/>
    </bean>
    <bean id="classProperties" class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <property name="locations">
            <list>
                <value>classpath:class.properties</value>
            </list>
        </property>
    </bean>
    <bean id="class2" class="iuh.fit.se.bai01.xmlbased.Class_">
        <property name="classId" value="DHKTPM"/>
        <property name="className" value="${className}"/>
    </bean>
</beans>